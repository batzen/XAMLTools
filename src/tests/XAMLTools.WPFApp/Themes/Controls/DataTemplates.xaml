<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys2="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary>
            <DataTemplate x:Key="DataTemplateFromAdHocMergedDict" DataType="{x:Type sys2:DateTime}" />
            <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverterFromAdHocMergedDict" />
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate DataType="{x:Type sys2:DateTime}" />
</ResourceDictionary>