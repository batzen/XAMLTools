<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:System.Windows;assembly=PresentationFramework">
    <Style TargetType="{x:Type controls:Window}" BasedOn="{StaticResource WindowBaseStyle}" />

    <Style x:Key="WindowBaseStyle" TargetType="{x:Type controls:Window}" BasedOn="{StaticResource {x:Type controls:Window}}">
        <Setter Property="Title" Value="External base style" />
    </Style>
</ResourceDictionary>
